# Host-side defaults for agent-sbx.
# This file contains no secrets.

# Where session baselines/results live on the host. The agent never sees this path.
: "${AGENT_SBX_HOME:=$HOME/.local/state/agent-sbx}"

# Require the current security-hardened release line. Docker Sandboxes 0.45.0 includes
# additional credential-revocation and fail-closed network-policy fixes on top of the
# macOS host-boundary fixes introduced in 0.42.0.
: "${AGENT_SBX_MIN_VERSION:=0.45.0}"

# Sandbox resource limits. Leave memory empty to use sbx's default.
: "${AGENT_SBX_CPUS:=0}"
: "${AGENT_SBX_MEMORY:=}"

# Built-in agent templates already include common development tools and a private Docker Engine.
# Override per create with --template if you build one of the optional templates in templates/.
: "${AGENT_SBX_CODEX_TEMPLATE:=}"
: "${AGENT_SBX_CLAUDE_TEMPLATE:=}"

# Explicit, temporary dependency-bootstrap network access.
# Running `agent-sbx prepare` is the approval event. The rule is removed on exit.
: "${AGENT_SBX_PREPARE_HOSTS:=registry.npmjs.org,registry.yarnpkg.com}"

# Loopback-only preview defaults.
: "${AGENT_SBX_PREVIEW_HOST:=127.0.0.1}"

# Strict preflight: do not create an autonomous sandbox if host-global credentials or
# Docker Sandbox MCP registrations already exist. These are explicit cross-boundary paths.
: "${AGENT_SBX_REQUIRE_EMPTY_GLOBAL_SECRETS:=1}"
: "${AGENT_SBX_REQUIRE_EMPTY_MCP:=1}"
